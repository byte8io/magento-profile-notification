    <!-- Logger Configuration -->
    <virtualType name="Byte8\ProfileNotification\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">profile_notification</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Byte8\ProfileNotification\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="Byte8\ProfileNotification\Logger\Handler"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/profile_notification.log</argument>
        </arguments>
    </virtualType>

    <type name="Byte8\ProfileNotification\Model\NotificationManagement">
        <arguments>
            <argument name="logger" xsi:type="object">Byte8\ProfileNotification\Logger</argument>
        </arguments>
    </type>

    <!-- Grid Collection -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="byte8_profile_notification_listing_data_source" xsi:type="string">Byte8\ProfileNotification\Model\ResourceModel\Grid\Collection</item>
                <item name="byte8_profile_notification_summary_listing_data_source" xsi:type="string">Byte8\ProfileNotification\Model\ResourceModel\Summary\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!-- Virtual Grid Collection -->
    <virtualType name="Byte8\ProfileNotification\Model\ResourceModel\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">byte8_profile_notification</argument>
            <argument name="resourceModel" xsi:type="string">Byte8\ProfileNotification\Model\ResourceModel\Notification</argument>
        </arguments>
    </virtualType>

    <!-- Virtual Summary Grid Collection -->
    <virtualType name="Byte8\ProfileNotification\Model\ResourceModel\Summary\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">byte8_profile_notification_summary</argument>
            <argument name="resourceModel" xsi:type="string">Byte8\ProfileNotification\Model\ResourceModel\NotificationSummary</argument>
        </arguments>
    </virtualType>

    <!-- Console Commands -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="byte8_notification_send_batch_emails" xsi:type="object">Byte8\ProfileNotification\Console\Command\SendBatchEmailsCommand</item>
            </argument>
        </arguments>
    </type>
</config>
