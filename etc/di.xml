<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Interface preferences -->
    <preference for="Byte8\ProfileNotification\Api\NotificationManagementInterface"
                type="Byte8\ProfileNotification\Model\NotificationManagement"/>
    <preference for="Byte8\ProfileNotification\Api\NotificationRepositoryInterface"
                type="Byte8\ProfileNotification\Model\NotificationRepository"/>
    <preference for="Byte8\ProfileNotification\Api\Data\NotificationInterface"
                type="Byte8\ProfileNotification\Model\Notification"/>
    <preference for="Byte8\ProfileNotification\Api\Data\NotificationSummaryInterface"
                type="Byte8\ProfileNotification\Model\NotificationSummary"/>
    <preference for="Byte8\ProfileNotification\Api\Data\NotificationSearchResultsInterface"
                type="Byte8\ProfileNotification\Model\NotificationSearchResults"/>
    <preference for="Byte8\ProfileNotification\Model\Email\SenderInterface"
                type="Byte8\ProfileNotification\Model\Email\Sender"/>

    <!-- Service Plugins -->
    <type name="Byte8\Profile\Model\ServiceAbstract\ServiceInterface">
        <plugin name="profile_notification_logger"
                type="Byte8\ProfileNotification\Plugin\ServiceNotificationPlugin"
                sortOrder="10"/>
    </type>

    <!-- Processor Plugins -->
    <type name="Byte8\Profile\Model\ServiceAbstract\ProcessorInterface">
        <plugin name="profile_notification_processor_logger"
                type="Byte8\ProfileNotification\Plugin\ProcessorNotificationPlugin"
                sortOrder="10"/>
    </type>

    <!-- Collect Management Plugins -->
    <!-- Plugin for AbstractCollectManagement base class -->
    <type name="Byte8\PlentyProfile\Model\CollectManagementInterface">
        <plugin name="profile_notification_collect_logger"
                type="Byte8\ProfileNotification\Plugin\CollectNotificationPlugin"
                sortOrder="10"/>
    </type>

    <type name="Byte8\ProfileNotification\Plugin\CollectNotificationPlugin">
        <arguments>
            <argument name="logger" xsi:type="object">Byte8\ProfileNotification\Logger</argument>
        </arguments>
    </type>

